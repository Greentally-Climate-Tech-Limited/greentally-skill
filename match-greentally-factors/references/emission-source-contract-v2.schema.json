{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://greentally.ai/schemas/emission-source-contract-v2.schema.json",
  "title": "Greentally Emission Source Analysis v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "records", "warnings", "summary"],
  "properties": {
    "schemaVersion": { "const": "emission-source-analysis/v2" },
    "records": { "type": "array", "items": { "$ref": "#/$defs/analysisRecord" } },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "summary": { "type": "string" }
  },
  "$defs": {
    "identifiers": {
      "type": "object", "additionalProperties": false, "minProperties": 1,
      "properties": { "accountNumber": { "type": "string" }, "meterNumber": { "type": "string" } }
    },
    "totals": {
      "type": "object", "additionalProperties": false, "minProperties": 1,
      "properties": {
        "netAmount": { "type": "number" }, "taxAmount": { "type": "number" }, "grossAmount": { "type": "number" },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }
      }
    },
    "sourceAdditionalInfo": {
      "type": "object", "additionalProperties": false, "minProperties": 1,
      "properties": { "identifiers": { "$ref": "#/$defs/identifiers" }, "totals": { "$ref": "#/$defs/totals" } }
    },
    "quantity": {
      "type": "object", "additionalProperties": false, "required": ["value"],
      "properties": { "value": { "type": "number" }, "unit": { "type": "string" } }
    },
    "money": {
      "type": "object", "additionalProperties": false, "required": ["value", "currency"],
      "properties": { "value": { "type": "number" }, "currency": { "type": "string", "pattern": "^[A-Z]{3}$" } }
    },
    "itemAdditionalInfo": {
      "type": "object", "additionalProperties": false, "minProperties": 1,
      "properties": {
        "productCode": { "type": "string" }, "quantity": { "$ref": "#/$defs/quantity" },
        "unitPrice": { "$ref": "#/$defs/money" }, "associatedCost": { "$ref": "#/$defs/money" }
      }
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["sourceId", "sourceName", "documentCategory"],
      "properties": {
        "sourceId": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "sourceName": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "documentCategory": { "type": "string", "enum": ["utility_bill", "invoice", "travel_document", "waste_document", "statement", "data_table", "other"] },
        "documentType": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
        "documentNumber": { "type": "string" }, "documentDate": { "type": "string", "format": "date" },
        "supplier": { "type": "string" }, "regionCode": { "type": "string", "pattern": "^(?:[A-Z]{3}|GLOBAL)$" },
        "location": { "type": "string" }, "additionalInfo": { "$ref": "#/$defs/sourceAdditionalInfo" }
      }
    },
    "input": {
      "type": "object", "additionalProperties": false, "required": ["type", "value", "unit"],
      "properties": {
        "type": { "type": "string", "enum": ["activity", "spend"] },
        "value": { "type": "number" }, "unit": { "type": "string", "minLength": 1, "pattern": "\\S" }
      },
      "allOf": [
        { "if": { "properties": { "type": { "const": "activity" } } }, "then": { "properties": { "value": { "exclusiveMinimum": 0 } } } },
        { "if": { "properties": { "type": { "const": "spend" } } }, "then": { "properties": { "value": { "minimum": 0 }, "unit": { "pattern": "^[A-Z]{3}$" } } } }
      ]
    },
    "item": {
      "type": "object", "additionalProperties": false,
      "required": ["itemId", "name", "input", "startDate", "endDate"],
      "properties": {
        "itemId": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "name": { "type": "string", "minLength": 1, "pattern": "\\S" }, "description": { "type": "string" },
        "input": { "$ref": "#/$defs/input" }, "regionCode": { "type": "string", "pattern": "^(?:[A-Z]{3}|GLOBAL)$" },
        "location": { "type": "string" }, "startDate": { "type": "string", "format": "date" },
        "endDate": { "type": "string", "format": "date" }, "additionalInfo": { "$ref": "#/$defs/itemAdditionalInfo" }
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false, "required": ["field", "quote"],
      "properties": {
        "field": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "quote": { "type": "string", "minLength": 1, "pattern": "\\S" }, "reference": { "type": "string" }
      }
    },
    "sourceRecord": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "source", "item", "evidence", "remarks"],
      "properties": {
        "schemaVersion": { "const": "emission-source-record/v2" }, "source": { "$ref": "#/$defs/source" },
        "item": { "$ref": "#/$defs/item" }, "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
        "remarks": { "type": "array", "items": { "type": "string" } }
      }
    },
    "categoryCandidate": {
      "type": "object", "additionalProperties": false, "required": ["id", "name", "confidence", "reason"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "pattern": "\\S" }, "name": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "confidence": { "type": "string", "enum": ["high", "medium", "low"] }, "reason": { "type": "string" }
      }
    },
    "matchingHints": {
      "type": "object", "additionalProperties": false,
      "required": ["activityName", "categoryCandidates", "fallbackRegionCodes", "factorKeywords"],
      "properties": {
        "activityName": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "categoryCandidates": { "type": "array", "maxItems": 3, "items": { "$ref": "#/$defs/categoryCandidate" } },
        "fallbackRegionCodes": { "type": "array", "maxItems": 3, "items": { "type": "string", "pattern": "^(?:[A-Z]{3}|GLOBAL)$" } },
        "factorKeywords": { "type": "array", "maxItems": 8, "items": { "type": "string", "minLength": 1, "pattern": "\\S" } },
        "releaseYear": { "type": "integer", "minimum": 1900, "maximum": 2200 }
      }
    },
    "analysisRecord": {
      "type": "object", "additionalProperties": false, "required": ["sourceRecord", "matchingHints"],
      "properties": { "sourceRecord": { "$ref": "#/$defs/sourceRecord" }, "matchingHints": { "$ref": "#/$defs/matchingHints" } }
    },
    "submissionItem": {
      "type": "object", "additionalProperties": false, "required": ["sourceRecord", "factorId"],
      "properties": { "sourceRecord": { "$ref": "#/$defs/sourceRecord" }, "factorId": { "type": "string", "minLength": 1, "pattern": "\\S" } }
    },
    "submission": {
      "type": "object", "additionalProperties": false, "required": ["schemaVersion", "items"],
      "properties": {
        "schemaVersion": { "const": "emission-source-submission/v2" },
        "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/submissionItem" } }
      }
    }
  }
}
